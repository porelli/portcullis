# ┌──────────────────────────────────────────────────────────┐
# │  Portcullis configuration — reference                    │
# │  ./portcullis init writes .env (0600) and generates      │
# │  every secret; empty secrets below are filled in by it.  │
# └──────────────────────────────────────────────────────────┘

# ── Domain ────────────────────────────────────────────────
# All subdomains (auth., hub., media., etc.) live under this
PORTCULLIS_DOMAIN=portcullis.example.com

# ── TLS Certificates ─────────────────────────────────────
# ACME (Let's Encrypt) for automatic wildcard certificate renewal.
#
# ACME_STAGING=true  → uses Let's Encrypt staging (untrusted certs, no rate limits)
#                      Good for testing. Browsers will show cert warnings.
#                      Launch Chrome with: --ignore-certificate-errors
# ACME_STAGING=false → uses Let's Encrypt production (trusted certs, rate-limited)
#                      Use once everything works.
# After changing: ./portcullis config apply && ./portcullis up
#
# See docs/certificates.md for details.
ACME_STAGING=false
ACME_EMAIL=admin@example.com

# DNS provider for ACME DNS-01 challenge (required for wildcard certs).
# Supported: cloudflare, porkbun, route53, gcloud, digitalocean, hetzner
# Full list: https://doc.traefik.io/traefik/https/acme/#providers
DNS_PROVIDER=cloudflare

# Cloudflare — https://dash.cloudflare.com/profile/api-tokens (Zone > DNS > Edit)
CLOUDFLARE_API_TOKEN=

# Porkbun — https://porkbun.com/account/api
#PORKBUN_API_KEY=
#PORKBUN_SECRET_API_KEY=

# AWS Route53
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_HOSTED_ZONE_ID=

# DigitalOcean
#DO_AUTH_TOKEN=

# Hetzner
#HETZNER_API_KEY=

# ── Client certificates (YubiKey PIV) ───────────────────
# Lifetime of issued client certs (Vault duration). Revocation is enforced
# on every request (group-gate) and at Keycloak X.509 login (CRL), so the
# lifetime only sets the renewal cadence: users renew themselves at
# https://enroll.<domain>/self while the cert is valid. Applied to new
# certs by ./portcullis pki setup / upgrade (rewrites the Vault role).
CLIENT_CERT_TTL=720h
# `portcullis status` / `cert list` warn when a user's newest cert has
# fewer days left than this.
#CERT_EXPIRY_WARN_DAYS=7

# ── mTLS (Client Certificates) ──────────────────────────
# MTLS_ENABLED=true  → Traefik requests client certificates (PIV/YubiKey)
#                      Apps use "authaware" TLS: cert optional, verified if present
#                      Vault UI uses "protected" TLS: cert required
# MTLS_ENABLED=false → No client certificates requested
#                      All TLS tiers behave like "public"; apps behind
#                      forward-auth still require a Keycloak (WebAuthn) login.
#                      WARNING: routers that rely ONLY on the "protected" TLS
#                      tier (e.g. a Vault UI with no portcullis-auth
#                      middleware) become UNAUTHENTICATED — there is no
#                      automatic WebAuthn fallback. Add
#                      portcullis-auth@docker,portcullis-groups@docker to them.
# After changing: ./portcullis config apply && ./portcullis up
#
# See docs/certificates.md for details.
MTLS_ENABLED=true

# ── Core Services ────────────────────────────────────────
# Vault runs in server mode (raft storage on the vault_data volume). There
# is no token in .env: ./portcullis vault init (run by init, upgrade and
# restore) initialises Vault and writes the root token + unseal key to
# secrets/vault-init.json and the enroll AppRole credentials to
# secrets/enroll/ (outside git, owner-only). Back up secrets/ OFFLINE.
# The CLI reads the root token from there unless VAULT_TOKEN is set.
#
# Every secret below is REQUIRED (docker compose refuses to start without
# it) and generated by ./portcullis init. Database / admin passwords cannot
# be changed here after the first start; the others can be rotated by
# emptying them and running ./portcullis upgrade.

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Branding — shown on the Keycloak login page
# Plain text or HTML (e.g., "<img src='https://example.com/logo.png' height='40'> My Portal")
PORTAL_DISPLAY_NAME=Portcullis

# PostgreSQL (Keycloak backend)
POSTGRES_PASSWORD=

# LLDAP (User directory)
LLDAP_ADMIN_PASSWORD=
LLDAP_JWT_SECRET=
LLDAP_BASE_DN=dc=portcullis,dc=example,dc=com

# ── Authentication ───────────────────────────────────────
# oauth2-proxy (forward auth for apps without native OIDC)
# Client secret of the portcullis-forward-auth Keycloak client;
# ./portcullis oidc register pushes it to Keycloak.
FORWARD_AUTH_CLIENT_SECRET=
# Cookie encryption secret: oauth2-proxy requires exactly 16, 24 or 32 bytes
# (raw, or base64url that decodes to that length), e.g.
#   openssl rand -base64 32 | tr -- '+/' '-_'
FORWARD_AUTH_COOKIE_SECRET=

# ── Hub ──────────────────────────────────────────────────
# Shared secret between Traefik and the Hub (X-Portcullis-Proxy-Secret
# header); the Hub refuses to start without it.
HUB_PROXY_SECRET=
# Hub image. `edge` = latest build of porelli/portcullis-hub main; releases
# are published as semver tags (pin one, ideally with @sha256:...).
#HUB_IMAGE=ghcr.io/porelli/portcullis-hub:edge
# The Hub never sees this file: it gets secrets/hub/core.env, generated by
# ./portcullis up with PORTCULLIS_DOMAIN, Traefik's IP, HEADSCALE_* /
# HEADPLANE_* / NETBIRD_* / COTURN_* and the names listed here
# (space-separated; core secrets are refused).
#HUB_SHARED_ENV=

# ── Docker networks ──────────────────────────────────────
# Fixed IPAM for the shared `portcullis-proxy` network (Traefik + apps).
# Header-auth apps trust identity headers only from PORTCULLIS_TRAEFIK_IP.
# Change these ONLY if 172.31.250.0/24 collides with a host/LAN/VPN
# network. Rules: PORTCULLIS_PROXY_IP_RANGE (dynamic container addresses)
# must be inside the subnet and must NOT contain PORTCULLIS_TRAEFIK_IP.
# Docker cannot change an existing network: after changing them disable the
# apps in the Hub, ./portcullis down, docker network rm portcullis-proxy,
# ./portcullis up, then re-enable the apps (their .env picks up the IP).
PORTCULLIS_PROXY_SUBNET=172.31.250.0/24
PORTCULLIS_PROXY_IP_RANGE=172.31.250.128/25
PORTCULLIS_TRAEFIK_IP=172.31.250.2
#
# Traefik <-> Keycloak network (internal, core only). Keycloak accepts proxy
# headers — including the forwarded client certificate used for X.509
# login — only from PORTCULLIS_AUTH_TRAEFIK_IP. Same rules as above; must
# not overlap PORTCULLIS_PROXY_SUBNET. Change with ./portcullis down && up.
PORTCULLIS_AUTH_SUBNET=172.31.251.0/28
PORTCULLIS_AUTH_IP_RANGE=172.31.251.8/29
PORTCULLIS_AUTH_TRAEFIK_IP=172.31.251.2

# ── Backups (docs/backups.md) ────────────────────────────
# ./portcullis backup [--offsite]. Backups contain secrets/ (Vault root
# token + unseal key) and this file: protect them like the keys.
# Off-host: a restic repository (s3:, b2:, azure:, gs:, rest:, or a local
# path), encrypted with BACKUP_PASSWORD. ./portcullis init generates the
# password — keep a copy OFFLINE: without it the off-host backups are
# useless, and the host's copy is lost with the host. Never change it once
# the repository exists.
#BACKUP_REPOSITORY=s3:https://s3.eu-central-1.amazonaws.com/<bucket>/portcullis
BACKUP_PASSWORD=
# Provider credentials, restic's names (AWS_*, B2_ACCOUNT_ID/_KEY, AZURE_*,
# GOOGLE_PROJECT_ID, RESTIC_REST_USERNAME/_PASSWORD). BACKUP_<NAME> wins
# over <NAME>, e.g. when AWS_* already hold the Route53 keys for ACME:
#BACKUP_AWS_ACCESS_KEY_ID=
#BACKUP_AWS_SECRET_ACCESS_KEY=
# Retention of the off-host snapshots (restic forget --prune):
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
#BACKUP_KEEP_MONTHLY=6
# Local backups kept in backups/:
#BACKUP_KEEP_LOCAL=7
# Share of the pack data `backup verify` reads (restic check --read-data-subset):
#BACKUP_VERIFY_READ_DATA=10%

# ── Monitoring (docs/monitoring.md) ──────────────────────
# Opt-in profile: Prometheus, Alertmanager, Grafana at https://metrics.<domain>
# (lldap_admin only). Enable, then ./portcullis up:
#COMPOSE_PROFILES=monitoring
#PROMETHEUS_RETENTION=30d
# Alert receivers (none set: alerts are only shown in Grafana).
#ALERT_WEBHOOK_URL=
#ALERT_NTFY_URL=https://ntfy.sh/<topic>
#ALERT_SMTP_SMARTHOST=smtp.example.com:587
#ALERT_SMTP_TO=ops@example.com
#ALERT_SMTP_FROM=portcullis@example.com
#ALERT_SMTP_USERNAME=
#ALERT_SMTP_PASSWORD=
#ALERT_SMTP_REQUIRE_TLS=true

# ── VPN (optional) ───────────────────────────────────────
# Headscale + Headplane
#HEADSCALE_OIDC_CLIENT_SECRET=
#HEADPLANE_OIDC_CLIENT_SECRET=
#HEADPLANE_COOKIE_SECRET=

# NetBird
#NETBIRD_OIDC_CLIENT_SECRET=
#COTURN_EXTERNAL_IP=
#COTURN_AUTH_SECRET=

# ── App secrets are auto-generated by the Hub on first enable ──
# You don't need to set these manually. The Hub generates them
# when you enable an app from the catalog.

# Comma-separated extra LLDAP groups whose members count as administrators:
# the Hub/API can't create invite links for them (recover with ./portcullis invite <user>).
# lldap_admin, lldap_password_manager and the core-console groups are always included.
#INVITE_PROTECTED_GROUPS=
