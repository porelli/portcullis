# ┌──────────────────────────────────────────────────────────┐
# │  Portcullis Configuration                                │
# │  Run ./scripts/bootstrap.sh to generate strong secrets   │
# └──────────────────────────────────────────────────────────┘

# ── Domain ────────────────────────────────────────────────
# All subdomains (auth., hub., media., etc.) live under this
PORTCULLIS_DOMAIN=portcullis.example.com

# ── TLS Certificates ─────────────────────────────────────
# ACME (Let's Encrypt) for automatic wildcard certificate renewal.
#
# ACME_STAGING=true  → uses Let's Encrypt staging (untrusted certs, no rate limits)
#                      Good for testing. Browsers will show cert warnings.
#                      Launch Chrome with: --ignore-certificate-errors
# ACME_STAGING=false → uses Let's Encrypt production (trusted certs, rate-limited)
#                      Use once everything works.
#
# See docs/certificates.md for details.
ACME_STAGING=true
ACME_EMAIL=admin@example.com

# DNS provider for ACME DNS-01 challenge (required for wildcard certs).
# Supported: cloudflare, porkbun, route53, gcloud, digitalocean, hetzner
# Full list: https://doc.traefik.io/traefik/https/acme/#providers
DNS_PROVIDER=cloudflare

# Cloudflare — https://dash.cloudflare.com/profile/api-tokens (Zone > DNS > Edit)
CLOUDFLARE_API_TOKEN=

# Porkbun — https://porkbun.com/account/api
#PORKBUN_API_KEY=
#PORKBUN_SECRET_API_KEY=

# AWS Route53
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_HOSTED_ZONE_ID=

# DigitalOcean
#DO_AUTH_TOKEN=

# Hetzner
#HETZNER_API_KEY=

# ── mTLS (Client Certificates) ──────────────────────────
# MTLS_ENABLED=true  → Traefik requests client certificates (PIV/YubiKey)
#                      Apps use "authaware" TLS: cert optional, verified if present
#                      Vault UI uses "protected" TLS: cert required
# MTLS_ENABLED=false → No client certificates requested
#                      All TLS tiers behave like "public"; apps behind
#                      forward-auth still require a Keycloak (WebAuthn) login.
#                      WARNING: routers that rely ONLY on the "protected" TLS
#                      tier (e.g. a Vault UI with no portcullis-auth
#                      middleware) become UNAUTHENTICATED — there is no
#                      automatic WebAuthn fallback. Add
#                      portcullis-auth@docker,portcullis-groups@docker to them.
#
# See docs/certificates.md for details.
MTLS_ENABLED=true

# ── Core Services ────────────────────────────────────────
# Vault runs in server mode (raft storage on the vault_data volume). There
# is no token in .env: ./scripts/vault-init.sh (run by bootstrap.sh and
# upgrade.sh) initialises Vault and writes the root token + unseal key to
# secrets/vault-init.json and the enroll AppRole credentials to
# secrets/enroll/ (outside git, owner-only). Back up secrets/ OFFLINE.
# Admin scripts read the root token from there unless VAULT_TOKEN is set.

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Branding — shown on the Keycloak login page
# Plain text or HTML (e.g., "<img src='https://example.com/logo.png' height='40'> My Portal")
PORTAL_DISPLAY_NAME=Portcullis

# PostgreSQL (Keycloak backend)
POSTGRES_PASSWORD=changeme

# LLDAP (User directory)
LLDAP_ADMIN_PASSWORD=changeme
LLDAP_JWT_SECRET=changeme-jwt-secret
LLDAP_BASE_DN=dc=portcullis,dc=example,dc=com

# ── Authentication ───────────────────────────────────────
# oauth2-proxy (forward auth for apps without native OIDC)
# Client secret of the portcullis-forward-auth Keycloak client. bootstrap.sh
# generates a random one; register-oidc-clients.sh pushes this value to
# Keycloak. The value below is a PUBLIC default — replace it, then run
# ./scripts/register-oidc-clients.sh && docker compose up -d forward-auth
FORWARD_AUTH_CLIENT_SECRET=portcullis-forward-auth-secret
# Cookie encryption secret. oauth2-proxy requires exactly 16, 24 or 32 bytes
# (raw, or base64url that decodes to that length). Generate with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
# The example below is valid-length but PUBLIC — never use it as-is.
FORWARD_AUTH_COOKIE_SECRET=REPLACE-ME-with-32-random-bytes_

# ── Docker networks ──────────────────────────────────────
# Fixed IPAM for the shared `portcullis-proxy` network (Traefik + apps).
# Header-auth apps trust identity headers only from PORTCULLIS_TRAEFIK_IP.
# Change these ONLY if 172.31.250.0/24 collides with a host/LAN/VPN
# network. Rules: PORTCULLIS_PROXY_IP_RANGE (dynamic container addresses)
# must be inside the subnet and must NOT contain PORTCULLIS_TRAEFIK_IP.
# After changing them run ./scripts/upgrade.sh (it recreates the network)
# and re-enable header-auth apps in the Hub so their .env picks up the IP.
PORTCULLIS_PROXY_SUBNET=172.31.250.0/24
PORTCULLIS_PROXY_IP_RANGE=172.31.250.128/25
PORTCULLIS_TRAEFIK_IP=172.31.250.2

# ── VPN (optional) ───────────────────────────────────────
# Headscale + Headplane
#HEADSCALE_OIDC_CLIENT_SECRET=
#HEADPLANE_OIDC_CLIENT_SECRET=
#HEADPLANE_COOKIE_SECRET=

# NetBird
#NETBIRD_OIDC_CLIENT_SECRET=
#COTURN_EXTERNAL_IP=
#COTURN_AUTH_SECRET=

# ── App secrets are auto-generated by the Hub on first enable ──
# You don't need to set these manually. The Hub generates them
# when you enable an app from the catalog.
