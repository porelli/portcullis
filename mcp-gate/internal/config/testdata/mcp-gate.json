{
  "version": 1,
  "enabled": true,
  "issuer": "https://auth.example.com/realms/portcullis",
  "main_domain": "example.com",
  "clients": [
    "ai-chat-mcp",
    "portcullis-ai-claude",
    "portcullis-ai-claude-code",
    "portcullis-ai-generic"
  ],
  "allowed_origins": [],
  "acr_loa": {
    "hwk": 2,
    "mtls": 3,
    "public": 0,
    "pwd": 1
  },
  "limits": {
    "resource_rpm": 120,
    "resource_burst": 30,
    "person_rpm": 600,
    "tool_calls_rpm": 60,
    "confirmations_per_hour": 10,
    "mints_per_minute": 10,
    "fanout": 4,
    "max_request_bytes": 8388608,
    "max_result_bytes": 16777216,
    "upstream_timeout_s": 120
  },
  "core_hosts": [
    "auth.example.com",
    "directory.example.com",
    "enroll.example.com",
    "example.com",
    "hub.example.com",
    "mcp.example.com",
    "metrics.example.com",
    "people.example.com",
    "traefik.example.com"
  ],
  "resources": [
    {
      "url": "https://gitea.example.com/mcp",
      "scope": "mcp:gitea.gitea",
      "clients": [
        "portcullis-ai-claude",
        "portcullis-ai-claude-code",
        "portcullis-ai-generic"
      ],
      "kind": "companion",
      "instance": "gitea",
      "companion": "gitea",
      "label": "Gitea",
      "host": "gitea.example.com",
      "hosts": [
        "gitea.example.com"
      ],
      "app_url": "https://gitea.example.com",
      "min_loa": 2,
      "upstream": "http://portcullis-mcp-gitea--gitea:8080/mcp",
      "protocol": [
        "2026-07-28",
        "2025-11-25"
      ],
      "mode": "read_write",
      "identity": {
        "mode": "app_token",
        "header": "Authorization",
        "format": "token {credential}",
        "basic_user": "",
        "secret_ref": ""
      },
      "tools": {
        "writes": [
          "*_write",
          "create_*",
          "update_*",
          "merge_*",
          "delete_*"
        ],
        "confirm": [
          "delete_*",
          "repo_write:delete"
        ],
        "never": []
      },
      "aggregate": true,
      "population": [
        "alice",
        "bob"
      ],
      "expiring": {
        "bob": "2027-03-31T23:59:59Z"
      }
    },
    {
