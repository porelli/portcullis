      "protocol": [
        "2025-11-25"
      ],
      "mode": "read_only",
      "identity": {
        "mode": "identity_headers",
        "header": "Authorization",
        "format": "Bearer {secret}",
        "basic_user": "",
        "secret_ref": "grafana/grafana"
