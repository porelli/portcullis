{
  "realm": "portcullis",
  "displayName": "Portcullis",
  "displayNameHtml": "<span style=\"font-size:2rem;font-weight:700;letter-spacing:-0.02em\">Portcullis</span>",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "portcullis",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 7776000,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "webAuthnPolicyRpEntityName": "Portcullis",
  "webAuthnPolicySignatureAlgorithms": ["ES256"],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "cross-platform",
  "webAuthnPolicyRequireResidentKey": "No",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyCreateTimeout": 60,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessRpEntityName": "Portcullis",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256"],
  "webAuthnPolicyPasswordlessRpId": "",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "direct",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 60,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpPolicyInitialCounter": 0,
  "eventsEnabled": true,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "IMPERSONATE", "UPDATE_CREDENTIAL", "REMOVE_CREDENTIAL"],
  "eventsExpiration": 31536000,
  "attributes": {
    "acr.loa.map": "{}"
  },
  "authenticationFlows": [
    {
      "alias": "portcullis-universal",
      "description": "Sign-in methods (contract §8.1): the SSO cookie, the invite identity provider (only with kc_idp_hint) or a sign-in method, then the app's sign-in template",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "flowAlias": "portcullis-authenticate"
        },
        {
          "authenticator": "portcullis-template",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "portcullis-authenticate",
      "description": "SSO cookie (unless pc_method asks for a method the session lacks), the invite identity provider, or a sign-in method",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "portcullis-signin"
        }
      ]
    },
    {
      "alias": "portcullis-signin",
      "description": "YubiKey certificate, then browser certificate (automatic when the browser presents one of that kind's CA), a passkey, a password, or an authenticator code (only once the user is known); each only while its method is on",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "portcullis-x509",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorConfig": "x509-config"
        },
        {
          "authenticator": "portcullis-x509",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorConfig": "x509-browser-config"
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "portcullis-signin-passkey"
        },
        {
          "authenticator": "portcullis-password-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 40,
          "authenticatorConfig": "password-config"
        },
        {
          "authenticator": "portcullis-otp",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 50,
          "authenticatorConfig": "otp-config"
        }
      ]
    },
    {
      "alias": "portcullis-signin-passkey",
      "description": "A passkey of a kind that is on; its kind decides the amr (hwk, dpk, spk)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "portcullis-passkey",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "portcullis-passkey-security-key"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "portcullis-passkey-device"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 40,
          "flowAlias": "portcullis-passkey-synced"
        }
      ]
    },
    {
      "alias": "portcullis-passkey-security-key",
      "description": "The passkey that signed in is a security key: the session gets its amr while the method is on",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "portcullis-condition-passkey-kind",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "passkey-kind-security-key"
        },
        {
          "authenticator": "portcullis-method",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "method-security-key"
        }
      ]
    },
    {
      "alias": "portcullis-passkey-device",
      "description": "The passkey that signed in is a device-bound passkey: the session gets its amr while the method is on",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "portcullis-condition-passkey-kind",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "passkey-kind-device"
        },
        {
          "authenticator": "portcullis-method",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "method-device"
        }
      ]
    },
    {
      "alias": "portcullis-passkey-synced",
      "description": "The passkey that signed in is a synced passkey: the session gets its amr while the method is on",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "portcullis-condition-passkey-kind",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "passkey-kind-synced"
        },
        {
          "authenticator": "portcullis-method",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "method-synced"
        }
      ]
    },
    {
      "alias": "portcullis-invite-link",
      "description": "First login through the invite identity provider: link to the existing (LLDAP) user with that username, never create one",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "portcullis-invite-session",
      "description": "After an invite login: only clients with the portcullis-invite-client scope (portcullis-forward-auth), any other is denied; then amr inv and the template check",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "portcullis-invite-client"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "portcullis-invite-deny"
        },
        {
          "authenticator": "allow-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorConfig": "amr-inv-invite"
        },
        {
          "authenticator": "portcullis-template",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 40
        }
      ]
    },
    {
      "alias": "portcullis-invite-client",
      "description": "The client has the portcullis-invite-client scope (only portcullis-forward-auth has it): a missing scope is false",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-client-scope",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "invite-client-scope"
        },
        {
          "authenticator": "allow-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "portcullis-invite-deny",
      "description": "Deny every invite login portcullis-invite-client did not admit (also when that sub-flow is missing or renamed)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-sub-flow-executed",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "invite-client-not-admitted"
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "invite-client-deny"
        }
      ]
    },
    {
      "alias": "portcullis-registration-flow",
      "description": "Registration flow (registration is disabled)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "x509-config",
      "config": {
        "x509-cert-auth.canonical-dn-enabled": "false",
        "x509-cert-auth.serialnumber-hex-enabled": "false",
        "x509-cert-auth.regular-expression": "(.*?)(?:$)",
        "x509-cert-auth.mapper-selection": "Username or Email",
        "x509-cert-auth.mapper-selection.user-attribute-name": "usercertificate",
        "x509-cert-auth.mapping-source-selection": "Subject's Common Name",
        "x509-cert-auth.crl-checking-enabled": "true",
        "x509-cert-auth.crl-relative-path": "http://vault:8200/v1/pki_int/crl##http://vault:8200/v1/pki_int/crl/delta",
        "x509-cert-auth-crl-abort-if-non-updated": "true",
        "x509-cert-auth.crldp-checking-enabled": "false",
        "x509-cert-auth.ocsp-checking-enabled": "false",
        "x509-cert-auth.ocsp-responder-uri": "",
        "x509-cert-auth.revalidate-certificate-enabled": "true",
        "x509-cert-auth.timestamp-validation-enabled": "true",
        "x509-cert-auth.keyusage": "",
        "x509-cert-auth.extendedkeyusage": "1.3.6.1.5.5.7.3.2",
        "x509-cert-auth.confirmation-page-disallowed": "true",
        "default.reference.value": "mtls",
        "portcullis.method": "yubikey_cert",
        "portcullis.ca": "/opt/keycloak/conf/truststores/portcullis/portcullis-yubikey-ca.pem",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "x509-browser-config",
      "config": {
        "x509-cert-auth.canonical-dn-enabled": "false",
        "x509-cert-auth.serialnumber-hex-enabled": "false",
        "x509-cert-auth.regular-expression": "(.*?)(?:$)",
        "x509-cert-auth.mapper-selection": "Username or Email",
        "x509-cert-auth.mapper-selection.user-attribute-name": "usercertificate",
        "x509-cert-auth.mapping-source-selection": "Subject's Common Name",
        "x509-cert-auth.crl-checking-enabled": "true",
        "x509-cert-auth.crl-relative-path": "http://vault:8200/v1/pki_file/crl##http://vault:8200/v1/pki_file/crl/delta",
        "x509-cert-auth-crl-abort-if-non-updated": "true",
        "x509-cert-auth.crldp-checking-enabled": "false",
        "x509-cert-auth.ocsp-checking-enabled": "false",
        "x509-cert-auth.ocsp-responder-uri": "",
        "x509-cert-auth.revalidate-certificate-enabled": "true",
        "x509-cert-auth.timestamp-validation-enabled": "true",
        "x509-cert-auth.keyusage": "",
        "x509-cert-auth.extendedkeyusage": "1.3.6.1.5.5.7.3.2",
        "x509-cert-auth.confirmation-page-disallowed": "true",
        "default.reference.value": "file",
        "portcullis.method": "browser_cert",
        "portcullis.ca": "/opt/keycloak/conf/truststores/portcullis/portcullis-browser-ca.pem",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "password-config",
      "config": { "default.reference.value": "pwd", "default.reference.maxAge": "36000" }
    },
    {
      "alias": "otp-config",
      "config": { "default.reference.value": "otp", "default.reference.maxAge": "36000" }
    },
    {
      "alias": "passkey-kind-security-key",
      "config": { "kind": "security_key" }
    },
    {
      "alias": "method-security-key",
      "config": { "method": "security_key", "default.reference.value": "hwk", "default.reference.maxAge": "36000" }
    },
    {
      "alias": "passkey-kind-device",
      "config": { "kind": "passkey_device" }
    },
    {
      "alias": "method-device",
      "config": { "method": "passkey_device", "default.reference.value": "dpk", "default.reference.maxAge": "36000" }
    },
    {
      "alias": "passkey-kind-synced",
      "config": { "kind": "passkey_synced" }
    },
    {
      "alias": "method-synced",
      "config": { "method": "passkey_synced", "default.reference.value": "spk", "default.reference.maxAge": "36000" }
    },
    {
      "alias": "invite-client-scope",
      "config": {
        "client_scope": "portcullis-invite-client",
        "negate": "false"
      }
    },
    {
      "alias": "invite-client-not-admitted",
      "config": {
        "flow_to_check": "portcullis-invite-client",
        "check_result": "not-executed"
      }
    },
    {
      "alias": "invite-client-deny",
      "config": {
        "denyErrorMessage": "Setup links work only through the Portcullis sign-in page. Open the link again."
      }
    },
    {
      "alias": "amr-inv-invite",
      "config": { "default.reference.value": "inv", "default.reference.maxAge": "36000" }
    }
  ],
  "browserFlow": "portcullis-universal",
  "requiredActions": [
    {
      "alias": "webauthn-register",
      "name": "WebAuthn Register",
      "providerId": "webauthn-register",
      "enabled": false,
      "defaultAction": false,
      "priority": 70
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "WebAuthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 85,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "portcullis-impersonation-notice",
      "name": "Impersonation notice",
      "providerId": "portcullis-impersonation-notice",
      "enabled": true,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "delete_credential",
      "name": "Delete Credential",
      "providerId": "delete_credential",
      "enabled": true,
      "defaultAction": false,
      "priority": 100,
      "config": { "max_auth_age": "300" }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "lldap",
        "providerId": "ldap",
        "config": {
          "vendor": ["other"],
          "connectionUrl": ["ldap://lldap:3890"],
          "bindDn": ["uid=admin,ou=people,LLDAP_BASE_DN_PLACEHOLDER"],
          "bindCredential": ["LLDAP_PASSWORD_PLACEHOLDER"],
          "usersDn": ["ou=people,LLDAP_BASE_DN_PLACEHOLDER"],
          "customUserSearchFilter": ["(!(uid=portcullis-hub))"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["person"],
          "editMode": ["READ_ONLY"],
          "cachePolicy": ["NO_CACHE"],
          "removeInvalidUsersEnabled": ["true"],
          "trustEmail": ["false"],
          "syncRegistrations": ["false"],
          "importEnabled": ["true"],
          "batchSizeForSync": ["1000"],
          "fullSyncPeriod": ["3600"],
          "changedSyncPeriod": ["86400"],
          "searchScope": ["1"],
          "useTruststoreSpi": ["ldapsOnly"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "enabled": ["true"],
          "priority": ["0"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "user.model.attribute": ["username"],
                "is.mandatory.in.ldap": ["true"],
                "read.only": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "is.mandatory.in.ldap": ["true"],
                "read.only": ["true"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"],
                "user.model.attribute": ["firstName"],
                "is.mandatory.in.ldap": ["false"],
                "read.only": ["true"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "is.mandatory.in.ldap": ["false"],
                "read.only": ["true"]
              }
            },
            {
              "name": "groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": ["ou=groups,LLDAP_BASE_DN_PLACEHOLDER"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfUniqueNames"],
                "membership.ldap.attribute": ["uniqueMember"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "mode": ["READ_ONLY"],
                "drop.non.existing.groups.during.sync": ["true"]
              }
            }
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "saml-sp-example",
      "name": "Example SAML Service Provider",
      "description": "Template SAML SP client - duplicate and configure for each app",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "attributes": {
        "saml.server.signature": "true",
        "saml.server.signature.keyinfo.ext": "false",
        "saml.signing.certificate": "",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_force_name_id_format": "false",
        "saml_name_id_format": "username",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml_single_logout_service_url_redirect": "https://your-app.example.com/saml/sls",
        "saml.assertion.signature": "true"
      },
      "redirectUris": [
        "https://your-app.example.com/saml/acs"
      ],
      "adminUrl": "https://your-app.example.com/saml/acs",
      "baseUrl": "https://your-app.example.com",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-idp-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "friendly.name": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "username",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-idp-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "friendly.name": "username",
            "attribute.name": "username",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    },
    {
      "clientId": "portcullis-forward-auth",
      "name": "Portcullis Forward Auth",
      "description": "OIDC client used by Traefik forward auth middleware. AMR claims carry the session's sign-in methods to group-gate (contract §8.1).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "FORWARD_AUTH_CLIENT_SECRET_PLACEHOLDER",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://auth.portcullis.local/oauth2/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard authenticated user"
      },
      {
        "name": "admin",
        "description": "Administrator"
      }
    ]
  },
  "defaultRoles": ["user"]
}
