          "name": "example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "google-site-verification=abc123"
        }
      ],
      "want_error": "mail set: example.com TXT: only one v=spf1 TXT here"
    },
    {
      "name": "dkim selector with a dot refused",
      "records": [
        {
          "name": "a.b._domainkey.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DKIM1; k=ed25519; p=11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
        }
      ],
      "want_error": "mail set: a.b._domainkey.example.com TXT: the DKIM selector must be one DNS label"
    },
    {
      "name": "dkim not v=DKIM1 refused",
      "records": [
        {
          "name": "v1._domainkey.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "k=ed25519; p=x"
        }
      ],
      "want_error": "mail set: v1._domainkey.example.com TXT: must start with v=DKIM1;"
    },
    {
      "name": "dmarc p=none under floor reject refused",
      "records": [
        {
          "name": "_dmarc.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DMARC1; p=none; rua=mailto:dmarc-reports@example.com"
        }
      ],
      "want_error": "mail set: _dmarc.example.com TXT: p=none is below the floor reject"
    },
    {
      "name": "dmarc rua off-domain refused",
      "records": [
        {
          "name": "_dmarc.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DMARC1; p=reject; rua=mailto:dmarc-reports@example.com,mailto:reports@evil.example.net"
        }
      ],
      "want_error": "mail set: _dmarc.example.com TXT: rua mailto:reports@evil.example.net is not on example.com"
    },
    {
      "name": "dmarc ruf refused",
      "records": [
        {
          "name": "_dmarc.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DMARC1; p=reject; adkim=s; aspf=s; rua=mailto:dmarc-reports@example.com; ruf=mailto:dmarc-reports@example.com"
        }
      ],
      "want_error": "mail set: _dmarc.example.com TXT: ruf is not allowed"
    },
    {
      "name": "mta-sts id of 33 characters refused",
      "records": [
        {
          "name": "_mta-sts.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=STSv1; id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ],
      "want_error": "mail set: _mta-sts.example.com TXT: must be v=STSv1; id=<1–32 letters or digits>"
    },
    {
      "name": "tls-rpt rua off-domain refused",
      "records": [
        {
          "name": "_smtp._tls.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=TLSRPTv1; rua=mailto:tls@evil.example.net"
        }
      ],
      "want_error": "mail set: _smtp._tls.example.com TXT: must be v=TLSRPTv1; rua=mailto:<an address on example.com>"
    },
    {
      "name": "srv on a wrong port refused",
      "records": [
        {
          "name": "_submissions._tcp.example.com",
          "type": "SRV",
          "ttl": 3600,
          "value": "0 1 587 mail.example.com."
        }
      ],
      "want_error": "mail set: _submissions._tcp.example.com SRV: must be <priority> <weight> 465 mail.example.com."
    },
    {
      "name": "srv to a foreign host refused",
      "records": [
        {
          "name": "_imaps._tcp.example.com",
          "type": "SRV",
          "ttl": 3600,
          "value": "0 1 993 imap.evil.example.net."
        }
      ],
      "want_error": "mail set: _imaps._tcp.example.com SRV: must be <priority> <weight> 993 mail.example.com."
    },
    {
      "name": "_imap._tcp not 0 0 0 . refused",
      "records": [
        {
          "name": "_imap._tcp.example.com",
          "type": "SRV",
          "ttl": 3600,
          "value": "0 1 143 mail.example.com."
        }
      ],
      "want_error": "mail set: _imap._tcp.example.com SRV: must be 0 0 0 ."
    },
    {
      "name": "cname with wildcard=true refused",
      "context": {
        "wildcard": true
      },
      "records": [
        {
          "name": "mta-sts.example.com",
          "type": "CNAME",
          "ttl": 3600,
          "value": "mail.example.com."
        }
      ],
      "want_error": "mail set: mta-sts.example.com CNAME: only when the Hub asked with wildcard=false"
    },
    {
      "name": "cname to a foreign host refused",
      "records": [
        {
          "name": "autoconfig.example.com",
          "type": "CNAME",
          "ttl": 3600,
          "value": "evil.example.net."
        }
      ],
      "want_error": "mail set: autoconfig.example.com CNAME: the target must be mail.example.com."
    },
    {
      "name": "mx at _dmarc refused",
      "records": [
        {
          "name": "_dmarc.example.com",
          "type": "MX",
          "ttl": 3600,
          "value": "10 mail.example.com."
        }
      ],
      "want_error": "mail set: _dmarc.example.com MX: only TXT here"
    },
    {
      "name": "a name outside the table refused",
      "records": [
        {
          "name": "www.example.com",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=spf1 mx -all"
        }
      ],
      "want_error": "mail set: www.example.com TXT: not a mail record name"
    },
    {
      "name": "a name under another domain refused",
      "records": [
        {
          "name": "example.org",
          "type": "MX",
          "ttl": 3600,
          "value": "10 mail.example.com."
        }
      ],
      "want_error": "mail set: example.org MX: not under example.com"
    }
  ]
}
