#!/usr/bin/env bash
#
# portcullis — the single admin entrypoint for a Portcullis installation.
# Run `./portcullis help`. Logic lives in scripts/lib/*.sh (one file per area).
#
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
PORTCULLIS_HOME="$(cd "$(dirname "$_self")" && pwd)"
PORTCULLIS_LIB="$PORTCULLIS_HOME/scripts/lib"
# PORTCULLIS_ROOT (where .env, certs/, secrets/ live) may be overridden,
# e.g. by the tests; it defaults to this checkout.
PORTCULLIS_ROOT="${PORTCULLIS_ROOT:-$PORTCULLIS_HOME}"
# shellcheck disable=SC2034  # used by scripts/lib/backup.sh
PORTCULLIS_CALLER_PWD="$PWD"
unset _self _dir

for _lib in common network vault pki certs keycloak users domains mcpgate sessions dns config status monitoring backup signin vpn link mail ssh worker stack; do
  # shellcheck source=/dev/null
  source "$PORTCULLIS_LIB/$_lib.sh"
done
unset _lib

help_main() {
  cat <<'EOF'
Usage: portcullis <command> [options]

Setup and lifecycle:
  init                        First-time setup: .env + secrets, Vault, PKI, Keycloak, start
  up                          Start/update the core stack and wait until healthy
  down                        Stop the core stack (volumes and secrets are kept)
  upgrade                     Back up, pull, re-run idempotent setup steps, restart
  status                      Health overview (--json for machines, --textfile for Prometheus)
  version                     Core version and the Hub image in use

Backups:
  backup                      Consistent backup to backups/ (--offsite: also restic, encrypted)
  backup verify               restic check + restore + sanity checks (or --local)
  backup schedule             systemd timer for daily backups
  restore                     Restore a local or off-host (--from-offsite) backup

Configuration:
  config apply                Apply ACME_STAGING, rebuild the CA bundle
  config init                 Keep your settings in config/, a separate git repo
  dns plan                    The domain's DNS plan: records, CAA pin, DNSSEC (changes nothing)
  dns setup                   Write the planned records (A/AAAA, CAA) through the DNS provider
  dns check                   Public DNS checks only (no credentials); exit 1 on a problem

Vault and PKI:
  vault init                  Initialise/unseal Vault, set up the enroll AppRole
  vault unseal                Unseal Vault and wait until it is active
  vault rotate-enroll-secret  Issue a new enroll AppRole secret-id
  pki setup                   Create the internal certificate authority (idempotent)

Identity:
  invite                      One-time setup link: register a passkey, signed in (no password)
  lldap-ui                    Break-glass SSH tunnel to LLDAP's own web UI (server only)
  keycloak configure          Import/patch the portcullis realm
  oidc register               Create core OIDC clients, push their secrets from .env
  signin reset-core           Locked out of the Hub: put the Hub and people pages back on Standard

VPN:
  vpn init                    Set up the VPN service (wg) and the built-in WireGuard VPN
  vpn mode                    Which core surfaces are VPN-only: apps, admin or server (break-glass: apps)
  vpn builtin                 Switch the built-in VPN on or off
  vpn add-device              Make a built-in VPN device for a person (config + QR, shown once)
  vpn devices                 List VPN devices of every provider
  vpn revoke                  Remove a built-in VPN device

Servers:
  link init                   Set up the link role: the tunnel worker servers dial out to
  link status                 The link role and each worker server's last handshake
  worker join                 Join this host to a primary as a worker server (the code on stdin)
  worker status               The worker's agent and containers
  worker upgrade              Pull and restart the worker's agent
  worker leave                Take this worker's apps down and wipe its identity
  worker stop                 Stop one app instance on this worker (break-glass)
  worker start                Start an app instance on this worker again

Mail:
  mail enable                 Open the mail slot (certificate) and wire the mail provider
  mail disable                Unwire the mail provider (drains every domain first)
  mail status                 Mail status: the provider, its checks, certificate, TLSA, timer
  mail test                   Send a signed test message
  mail dkim                   dkim rotate <domain>: a new DKIM key now
  mail cert                   Issue or renew the mail certificate
  mail rotate                 The daily step: certificate, TLSA, the main domain's records
  mail schedule               Install the daily mail timer (--systemd)
  mail export                 Export a former account's mailbox as mbox
  mail restore-hold           restore-hold clear: lift a core restore's stale hold on the provider

SSH access:
  ssh enroll-self             Make this server a managed SSH host (one-time code on stdin)
  ssh breakglass-cert         Sign an SSH certificate straight from Vault (the Hub is down)

Kubernetes:
  kube check                  Refresh the cluster check the Hub reads (init's timer: every 6 h)
  node add                    A join code for a new cluster node (the code on stdout, once)
  node list                   The cluster's nodes, as the Hub lists them
  node remove                 Drain and remove a cluster node (asks for its typed id)
  node revoke                 Cut a lost or compromised node off now (asks for its typed id)
  ha status                   High availability: the checklist, quorum, nodes and guarantee
  ha enable                   Turn high availability on (experimental; resumable)

YubiKey and browser certificates:
  cert enroll                 New key + YubiKey certificate on a YubiKey
  cert renew                  New YubiKey certificate for the key already on the YubiKey
  cert revoke                 Revoke a YubiKey or browser certificate (enforced by group-gate)
  cert list                   List issued YubiKey and browser certificates
  cert sync                   Rewrite the revoked-serial list from Vault (both CAs)

Run 'portcullis <command> --help' for the options of a command.
EOF
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    help|-h|--help)
      # `portcullis help <command> [sub]` == `portcullis <command> [sub] --help`
      if [ $# -gt 0 ]; then main "$@" --help; else help_main; fi
      return 0 ;;
    "") help_main >&2; return 2 ;;
  esac
  cd "$PORTCULLIS_ROOT"
  # A worker server runs only `worker …`, help, version and status (§17.7).
  worker_role_guard "$cmd" "$@"
  cli_lock "$cmd" "$@"
  case "$cmd" in
    init|up|down|upgrade|status|version|backup|restore|config|dns|vault|pki|keycloak|oidc|invite|cert|signin|vpn|link|mail|ssh|kube|node|ha|worker)
      "cmd_$cmd" "$@" ;;
    lldap-ui) cmd_lldap_ui "$@" ;;
    *)
      printf "portcullis: unknown command '%s'\nRun 'portcullis help' for the list of commands.\n" "$cmd" >&2
      return 2 ;;
  esac
}

main "$@"
