# User config directory (separate git repo — see ./portcullis config init)
/config/

# User config symlinks (point into config/)
.env
docker-compose.override.yml
traefik/dynamic/local/

# Vault init material (root token, unseal key, AppRole creds) — never commit
secrets/*
!secrets/.gitkeep

# Generated / runtime
certs/
*.jks
*.p12
*.pem
*.key
*.crt
acme.json
backups/*
!backups/.gitkeep
# Textfile metrics written by ./portcullis (monitoring profile)
monitoring/textfile/*
!monitoring/textfile/.gitkeep
# Hub-generated copies of app template dirs (see hub volumes in docker-compose.yml)
/templates/
# Hub-written settings data files (see hub volumes in docker-compose.yml)
appfiles/
.hub/
# A worker server's agent data and generated folder-root binds (./portcullis worker)
/worker-data/
/docker-compose.worker.roots.yml
/docker-compose.worker.override.yml
!certs/.gitkeep
!traefik/dynamic/local/.gitkeep

# Playwright test artifacts
.playwright-mcp/

# OS
.DS_Store

# Python bytecode
__pycache__/
*.pyc
.venv/

# ./portcullis one-at-a-time lock (cli_lock)
.portcullis.lock

# The mailctl build output (go build in mailctl/): never committed.
/mailctl/mailctl
# A local `go build` in enroll/ (final review M10).
/enroll/enroll
# A local `go build` in nodeadm/.
/nodeadm/nodeadm
