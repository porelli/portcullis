# User config directory (separate git repo — see ./portcullis config init)
config/

# User config symlinks (point into config/)
.env
docker-compose.override.yml
traefik/dynamic/local/
headscale/config.local.yaml

# Vault init material (root token, unseal key, AppRole creds) — never commit
secrets/*
!secrets/.gitkeep

# Generated / runtime
certs/
*.jks
*.p12
*.pem
*.key
*.crt
acme.json
backups/*
!backups/.gitkeep
# Textfile metrics written by ./portcullis (monitoring profile)
monitoring/textfile/*
!monitoring/textfile/.gitkeep
# Hub-generated copies of app template dirs (see hub volumes in docker-compose.yml)
templates/
.hub/
!certs/.gitkeep
!traefik/dynamic/local/.gitkeep

# Playwright test artifacts
.playwright-mcp/

# OS
.DS_Store
