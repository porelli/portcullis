[
  {
    "domain": "ci.example.org",
    "mail_hostname": "mail.ci.example.org",
    "set": {
      "domain": "ci.example.org",
      "records": [
        {
          "name": "ci.example.org",
          "type": "MX",
          "ttl": 3600,
          "value": "10 mail.ci.example.org."
        },
        {
          "name": "ci.example.org",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=spf1 mx -all"
        },
        {
          "name": "_dmarc.ci.example.org",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DMARC1; p=reject; rua=mailto:dmarc-reports@ci.example.org"
        },
        {
          "name": "_mta-sts.ci.example.org",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=STSv1; id=fake1"
        },
        {
          "name": "_smtp._tls.ci.example.org",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=TLSRPTv1; rua=mailto:tls-reports@ci.example.org"
        },
        {
          "name": "fake._domainkey.ci.example.org",
          "type": "TXT",
          "ttl": 3600,
          "value": "v=DKIM1; k=ed25519; p=11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
        }
      ],
      "dkim": "auto"
    }
  },
